---
import Layout from "../../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

let dashboardHtml = "";

const possiblePaths = [
  path.resolve("./public/seoindex.html"),
  path.resolve("../local/SEOINDEX/seo-indexing-center-lashes-mglamour.html"),
  path.resolve("./local/SEOINDEX/seo-indexing-center-lashes-mglamour.html")
];

for (const p of possiblePaths) {
  if (fs.existsSync(p)) {
    dashboardHtml = fs.readFileSync(p, "utf8");
    break;
  }
}
---

{dashboardHtml ? (
  <Fragment set:html={dashboardHtml} />
) : (
  <Layout title="SEO Indexing Center | Lashes & MGlamour">
    <section class="py-20 text-center">
      <h1 class="text-2xl font-bold">SEO Indexing Center</h1>
      <p class="text-zinc-500">Dashboard template loading error.</p>
    </section>
  </Layout>
)}

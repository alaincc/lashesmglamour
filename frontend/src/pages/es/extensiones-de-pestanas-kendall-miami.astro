---
import Layout from "../../layouts/Layout.astro";
import FAQ from "../../components/FAQ.astro";
import GoogleReviews from "../../components/GoogleReviews.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";

const pageTitle = "Extensiones de Pestañas en Kendall Miami | Clásicas, Híbridas y Volumen | MGlamour";
const pageDescription = "Estudio principal de extensiones de pestañas en West Kendall, Miami (33175). Diseños personalizados MGlamour Custom Lash Mapping para sets Clásicos, Híbridos y Volumen. Reserva online.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://lashesmglamour.com/es/extensiones-de-pestanas-kendall-miami/" lang="es">
  <!-- Hero Banner -->
  <section class="relative bg-gradient-to-tr from-brand-light-pink via-white to-brand-light-pink/40 py-20 border-b border-brand-border overflow-hidden">
    <div class="container-custom relative z-10 max-w-5xl mx-auto text-center space-y-6">
      <span class="inline-block border border-brand-pink/20 bg-brand-pink/5 text-brand-pink text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full">
        ✨ El Estudio de Pestañas #1 en West Kendall
      </span>
      <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-brand-charcoal leading-tight">
        Extensiones de Pestañas en Kendall, Miami
      </h1>
      <p class="text-zinc-600 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Sets personalizados Clásicos, Híbridos y de Volumen diseñados específicamente para la forma de tus ojos. Ubicadas convenientemente en 4095 SW 137th Ave, Suite 3, Miami FL 33175.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-4">
        <a href="/es/book" class="w-full sm:w-auto bg-brand-pink hover:bg-brand-pink-hover text-white font-bold uppercase tracking-wider text-xs px-8 py-4 rounded transition-all shadow-lg shadow-brand-pink/20 hover:scale-[1.03]">
          Reservar Cita
        </a>
        <a href="https://wa.me/17864606580" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto border border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-white font-bold uppercase tracking-wider text-xs px-8 py-4 rounded transition-all">
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- MGlamour Custom Lash Mapping Section -->
  <section class="py-20 bg-white">
    <div class="container-custom max-w-5xl mx-auto space-y-12">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-pink block">Técnica Exclusiva</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-brand-charcoal">Diseño Personalizado — MGlamour Custom Lash Mapping</h2>
        <p class="text-sm text-zinc-500 leading-relaxed">
          A diferencia de los estilos genéricos, analizamos la salud de tu pestaña natural, la curvatura de tus ojos y tu estilo de vida para diseñar un mapa exclusivo a tu medida.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Natural / Classic -->
        <div class="bg-brand-light-pink/30 border border-brand-pink/10 p-6 rounded-2xl space-y-4">
          <div class="w-10 h-10 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink font-bold text-lg">1</div>
          <h3 class="font-heading text-xl font-bold text-brand-charcoal">Pestañas Clásicas — Classic Set</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Una extensión premium aplicada 1 a 1 sobre cada pestaña natural sana. Ideal para una definición elegante y aspecto natural de rímel.
          </p>
          <div class="pt-2 text-xs font-bold text-brand-pink">$120 • 90 min</div>
        </div>

        <!-- Hybrid -->
        <div class="bg-brand-light-pink/30 border border-brand-pink/10 p-6 rounded-2xl space-y-4">
          <div class="w-10 h-10 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink font-bold text-lg">2</div>
          <h3 class="font-heading text-xl font-bold text-brand-charcoal">Pestañas Híbridas — Hybrid Set</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            La combinación perfecta de pestañas clásicas y abanicos de volumen ligeros para lograr textura, plenitud y densidad.
          </p>
          <div class="pt-2 text-xs font-bold text-brand-pink">$140 • 100 min</div>
        </div>

        <!-- Volume -->
        <div class="bg-brand-light-pink/30 border border-brand-pink/10 p-6 rounded-2xl space-y-4">
          <div class="w-10 h-10 rounded-full bg-brand-pink/10 flex items-center justify-center text-brand-pink font-bold text-lg">3</div>
          <h3 class="font-heading text-xl font-bold text-brand-charcoal">Pestañas de Volumen — Volume Set</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Abanicos ultra ligeros elaborados a mano para máxima densidad, dramatismo y una línea de pestañas densa y glamurosa.
          </p>
          <div class="pt-2 text-xs font-bold text-brand-pink">$160 • 120 min</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Before & After Section -->
  <BeforeAfter lang="es" />

  <!-- Location & Serviced Neighborhoods -->
  <section class="py-20 bg-brand-light-pink/20 border-y border-brand-border">
    <div class="container-custom max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-pink block">Visita Nuestro Estudio en West Kendall</span>
        <h2 class="font-heading text-3xl font-bold text-brand-charcoal">Ubicadas en Kendall, FL</h2>
        <p class="text-sm text-zinc-600 leading-relaxed">
          Nuestro estudio de estética privado se encuentra en la SW 137th Ave con amplio estacionamiento gratuito. Atendemos a clientas de West Kendall, Tamiami, Kendale Lakes, The Hammocks, Westchester y Pinecrest.
        </p>

        <div class="space-y-3 text-xs text-zinc-700">
          <div class="flex items-start space-x-3">
            <span class="text-brand-pink font-bold">📍 Dirección:</span>
            <span>4095 SW 137th Ave, Suite 3, Miami, FL 33175</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-brand-pink font-bold">📞 Teléfono:</span>
            <span>+1 (786) 460-6580</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-brand-pink font-bold">⏰ Horario:</span>
            <span>Lunes a Sábado: 9:00 AM - 8:00 PM | Domingo: Cerrado</span>
          </div>
        </div>

        <div class="pt-4 flex gap-4">
          <a href="https://maps.google.com/?q=4095+SW+137th+Ave+Suite+3+Miami+FL+33175" target="_blank" rel="noopener noreferrer" class="bg-brand-pink hover:bg-brand-pink-hover text-white font-bold text-xs uppercase tracking-wider px-6 py-3 rounded transition-all shadow-md">
            Cómo Llegar
          </a>
          <a href="tel:+17864606580" class="border border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-white font-bold text-xs uppercase tracking-wider px-6 py-3 rounded transition-all">
            Llamar al Estudio
          </a>
        </div>
      </div>

      <!-- Map Embed Container -->
      <div class="w-full h-80 rounded-2xl overflow-hidden shadow-lg border border-brand-border">
        <iframe 
          title="Mapa de Ubicación de Lashes & MGlamour" 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3593.4473859664536!2d-80.4172!3d25.7303!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9c123456789ab%3A0x0!2zNDA5NSBTVyAxMzd0aCBBdmUgIzMsIE1pYW1pLCBGTCAzMzE3NQ!5e0!3m2!1ses!2sus!4v1700000000000" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Google Reviews Component -->
  <GoogleReviews lang="es" />

  <!-- Local FAQs -->
  <FAQ lang="es" />

  <!-- Final CTA -->
  <section class="py-20 bg-white text-center">
    <div class="container-custom max-w-3xl mx-auto space-y-6">
      <h2 class="font-heading text-3xl font-bold text-brand-charcoal">¿Lista para lucir tus pestañas en Kendall?</h2>
      <p class="text-sm text-zinc-500">Reserva tu cita personalizada en menos de 2 minutos.</p>
      <a href="/es/book" class="inline-block bg-brand-pink hover:bg-brand-pink-hover text-white font-bold uppercase tracking-wider text-xs px-10 py-4 rounded transition-all shadow-xl shadow-brand-pink/20 hover:scale-105">
        Reservar Cita Online
      </a>
    </div>
  </section>
</Layout>
